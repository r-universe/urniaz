[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "ai"]
	path = ai
	url = https://github.com/urniaz/ai
	subdir = ai
[submodule "normanR"]
	path = normanR
	url = https://github.com/urniaz/normanr
	subdir = normanR
[submodule "testthatdocs"]
	path = testthatdocs
	url = https://github.com/urniaz/testthatdocs
	subdir = testthatdocs
